# ========================================================
# POPO LIVE API — DEVELOPMENT ENVIRONMENT CONFIGURATION
# (Template only — No real production secrets committed)
# ========================================================

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000

# Database & Cache
DATABASE_URL=postgresql://nordleads:local-platform-password@127.0.0.1:55432/nordleads?schema=popolive
REDIS_URL=redis://127.0.0.1:6379

# Cryptographic Token Salts (Minimum 32 characters in production)
AUTH_SECRET=poppo-live-auth-secret-dev-dummy-key-2026
CONSENT_SECRET_KEY=poppo-live-consent-salt-dev-2026

# ========================================================
# PHASE 8 PRODUCTION PROVIDER FEATURE FLAGS
# (ALL DEFAULT FALSE -> Preserves Phase 7 mock/database logic)
# ========================================================
USE_REAL_OTP=false
USE_REAL_STORAGE=false
USE_REAL_WEBSOCKET=false
USE_REAL_MEDIA=false
USE_REAL_PARTY_MEDIA=false
USE_REAL_PAYMENTS=false
USE_REAL_PUSH=false
USE_REAL_KYC=false
USE_REAL_ADMIN=false

# ========================================================
# 1. TELEPHONY & TRANSACTIONAL EMAIL (OTP)
# ========================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_VERIFY_SERVICE_SID=
LOCAL_SMS_GATEWAY_URL=
LOCAL_SMS_API_KEY=
LOCAL_SMS_SENDER_ID=
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@popolive.com

# ========================================================
# 2. OBJECT FILE STORAGE (Avatars, Posters, SVGA)
# ========================================================
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=popolive-dev-storage
R2_PUBLIC_DOMAIN=https://dev-media.popolive.com

# ========================================================
# 3. WEBSOCKET REAL-TIME PUBSUB
# ========================================================
WEBSOCKET_PORT=4001
REDIS_PUBSUB_URL=redis://127.0.0.1:6379

# ========================================================
# 4. LIVE STREAMING MEDIA INFRASTRUCTURE (Agora / LiveKit)
# ========================================================
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
LIVEKIT_API_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ========================================================
# 5. PARTY VOICE / VIDEO INFRASTRUCTURE (9-Seat SFU)
# ========================================================
AGORA_PARTY_APP_ID=
AGORA_PARTY_CERTIFICATE=

# ========================================================
# 6. PAYMENTS & COIN TOP-UP RAILS
# ========================================================
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
JAZZCASH_MERCHANT_ID=
JAZZCASH_PASSWORD=
JAZZCASH_INTEGRITY_SALT=
EASYPAISA_STORE_ID=
EASYPAISA_HASH_KEY=
PAYFAST_MERCHANT_ID=
PAYFAST_SECURED_KEY=

# ========================================================
# 7. PUSH NOTIFICATIONS (FCM / APNs)
# ========================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ========================================================
# 8. IDENTITY VERIFICATION (KYC) & PAYOUT RAILS
# ========================================================
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
PERSONA_API_KEY=
PERSONA_TEMPLATE_ID=
RAAST_API_URL=
RAAST_API_KEY=
RAAST_MERCHANT_ID=
STRIPE_CONNECT_CLIENT_ID=

# ========================================================
# 9. STANDALONE ADMIN DESK
# ========================================================
ADMIN_PORT=4002
ADMIN_JWT_SECRET=poppo-live-admin-jwt-salt-dev-2026
ADMIN_ALLOWED_IPS=127.0.0.1,::1

# ========================================================
# 10. MONITORING, LOGGING & ERROR TRACKING
# ========================================================
SENTRY_DSN=
DATADOG_API_KEY=
LOG_LEVEL=debug
