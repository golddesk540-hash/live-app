# ========================================================
# POPPO LIVE – AUTHENTICATION & DATABASE ENVIRONMENT CONFIG
# ========================================================

# PostgreSQL Connection String
DATABASE_URL=postgresql://nordleads:local-platform-password@127.0.0.1:55432/nordleads?schema=popolive

# Application Base URL
APP_URL=http://localhost:3000

# Cryptographic Token Secrets (Must be at least 32 characters)
AUTH_SECRET=poppo-live-auth-secret-super-secure-key-2026
CONSENT_SECRET_KEY=poppo-live-secure-consent-salt-2026-v4

# --------------------------------------------------------
# SMS PROVIDER (Twilio / Telephony Gateway)
# When left empty, OTPs are safely logged to server console
# for local development and QA verification without SMS costs.
# --------------------------------------------------------
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# --------------------------------------------------------
# OAUTH PROVIDERS
# Configure callbacks:
# Google:   {APP_URL}/api/auth/callback/google
# Facebook: {APP_URL}/api/auth/callback/facebook
# Apple:    {APP_URL}/api/auth/callback/apple
# --------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# --------------------------------------------------------
# SMTP TRANSACTIONAL EMAIL (Password Reset)
# --------------------------------------------------------
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=support@popolive.com
