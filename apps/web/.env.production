# ========================================================
# POPO LIVE WEB — PRODUCTION ENVIRONMENT CONFIGURATION
# (Template only — No real production secrets committed)
# ========================================================

NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://popolive.com
APP_URL=https://popolive.com

# Database & Cache (Managed Cluster)
DATABASE_URL=postgresql://prod_user:prod_password_placeholder@prod-db-cluster.popolive.internal:5432/popolive_prod?schema=popolive&sslmode=require
REDIS_URL=rediss://prod-redis-cluster.popolive.internal:6379

# Cryptographic Token Salts (From Secret Vault)
AUTH_SECRET=production-auth-secret-from-vault-min-64-hex
CONSENT_SECRET_KEY=production-consent-salt-from-vault-min-64-hex

# ========================================================
# PHASE 8 PRODUCTION PROVIDER FEATURE FLAGS
# (ALL DEFAULT FALSE -> Preserves Phase 7 mock/database logic until authorized)
# ========================================================
USE_REAL_OTP=false
USE_REAL_STORAGE=false
USE_REAL_WEBSOCKET=false
USE_REAL_MEDIA=false
USE_REAL_PARTY_MEDIA=false
USE_REAL_PAYMENTS=false
USE_REAL_PUSH=false
USE_REAL_KYC=false
USE_REAL_ADMIN=false

# ========================================================
# 1. SMS & EMAIL GATEWAY (OTP)
# ========================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@popolive.com

# ========================================================
# 2. OBJECT STORAGE (Avatars, Covers)
# ========================================================
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=popolive-prod-media
NEXT_PUBLIC_MEDIA_URL=https://media.popolive.com

# ========================================================
# 3. WEBSOCKET REAL-TIME
# ========================================================
NEXT_PUBLIC_WS_URL=wss://ws.popolive.com

# ========================================================
# 4. LIVE MEDIA (Agora Web SDK)
# ========================================================
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ========================================================
# 5. PAYMENTS (Stripe Web Checkout)
# ========================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ========================================================
# 6. SENTRY & OBSERVABILITY
# ========================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
