# ========================================================
# POPO LIVE WEB — STAGING ENVIRONMENT CONFIGURATION
# (Template only — No real production secrets committed)
# ========================================================

NODE_ENV=staging
PORT=3000
NEXT_PUBLIC_APP_URL=https://staging.popolive.com
APP_URL=https://staging.popolive.com

# Database & Cache
DATABASE_URL=postgresql://staging_user:staging_password_placeholder@staging-db.popolive.internal:5432/popolive_staging?schema=popolive
REDIS_URL=redis://staging-redis.popolive.internal:6379

# Cryptographic Token Salts
AUTH_SECRET=staging-auth-secret-placeholder-minimum-32-chars
CONSENT_SECRET_KEY=staging-consent-salt-placeholder-minimum-32-chars

# ========================================================
# MODULE API FEATURE FLAGS (Phase B0: ALL DEFAULT FALSE)
# Master Plan: POPO-LIVE-BACKEND-REALTIME-PLAN.pdf
# ========================================================
NEXT_PUBLIC_USE_LIVE_API=true
NEXT_PUBLIC_USE_PARTY_API=false
NEXT_PUBLIC_USE_MESSAGE_API=false
NEXT_PUBLIC_USE_ECONOMY_API=false
NEXT_PUBLIC_USE_VIP_API=false
NEXT_PUBLIC_USE_STORE_API=false
NEXT_PUBLIC_USE_COMMUNITY_API=false
NEXT_PUBLIC_USE_FINAL_API=false

# ========================================================
# REAL PRODUCTION PROVIDER FEATURE FLAGS (ALL DEFAULT FALSE)
# ========================================================
USE_REAL_OTP=false
USE_REAL_STORAGE=false
USE_REAL_WEBSOCKET=false
USE_REAL_MEDIA=false
USE_REAL_PARTY_MEDIA=false
USE_REAL_PAYMENTS=false
USE_REAL_PUSH=false
USE_REAL_KYC=false
USE_REAL_PAYOUT=false
USE_REAL_ADMIN=false
NEXT_PUBLIC_USE_REAL_MEDIA=false
NEXT_PUBLIC_USE_REAL_PARTY_MEDIA=false
NEXT_PUBLIC_USE_REAL_WEBSOCKET=false
NEXT_PUBLIC_USE_REAL_PAYMENTS=false
NEXT_PUBLIC_USE_REAL_PUSH=false

# ========================================================
# 1. SMS & EMAIL GATEWAY (OTP)
# ========================================================
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=staging-support@popolive.com

# ========================================================
# 2. OBJECT STORAGE (Avatars, Covers)
# ========================================================
STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=popolive-staging-storage
NEXT_PUBLIC_MEDIA_URL=https://staging-media.popolive.com

# ========================================================
# 3. WEBSOCKET REAL-TIME
# ========================================================
NEXT_PUBLIC_WS_URL=wss://staging-ws.popolive.com

# ========================================================
# 4. LIVE MEDIA (Agora Web SDK)
# ========================================================
NEXT_PUBLIC_AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# ========================================================
# 5. PAYMENTS (Stripe Web Checkout)
# ========================================================
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ========================================================
# 6. SENTRY & OBSERVABILITY
# ========================================================
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
