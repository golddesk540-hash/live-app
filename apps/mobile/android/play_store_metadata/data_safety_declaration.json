{
  "data_collection_and_security": {
    "data_collected": true,
    "data_shared_with_third_parties": false,
    "security_practices": {
      "data_encrypted_in_transit": true,
      "encryption_protocol": "TLS 1.3 / HTTPS",
      "user_can_request_data_deletion": true,
      "deletion_request_url": "https://popolive.com/account/delete",
      "deletion_process": "Settings > Account & Security > Delete Account"
    },
    "collected_data_types": [
      {
        "category": "Personal Info",
        "types": ["Name", "Email Address", "User IDs", "Phone Number (optional)"],
        "purpose": ["App functionality", "Account management", "Fraud prevention & security"],
        "is_optional": false
      },
      {
        "category": "Financial Info",
        "types": ["Purchase History", "In-App Billing Transaction IDs"],
        "purpose": ["App functionality", "Virtual wallet credit", "Fraud prevention"],
        "is_optional": false
      },
      {
        "category": "Messages",
        "types": ["In-App Direct Messages", "Live Stream Chat Comments"],
        "purpose": ["App functionality", "Community safety & moderation"],
        "is_optional": true
      },
      {
        "category": "Photos and Videos",
        "types": ["User-uploaded Square feed media", "Profile Avatars"],
        "purpose": ["App functionality", "User profile display"],
        "is_optional": true
      },
      {
        "category": "Audio Files",
        "types": ["Microphone voice stream (Live broadcast & Party seats)"],
        "purpose": ["App functionality (Real-time Agora RTC streaming, ephemeral)"],
        "is_optional": false
      },
      {
        "category": "App Info and Performance",
        "types": ["Crash Logs", "Diagnostics", "Performance Metrics"],
        "purpose": ["Analytics", "App performance optimization"],
        "is_optional": true
      },
      {
        "category": "Device or Other Identifiers",
        "types": ["Device Registration Token (FCM / Push Notifications)"],
        "purpose": ["App functionality", "Push alerts"],
        "is_optional": true
      }
    ]
  }
}
